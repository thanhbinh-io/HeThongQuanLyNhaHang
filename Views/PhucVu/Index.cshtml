@model IEnumerable<NhaHangThanhThao.ViewModels.PhucVuBanViewModel>

@{
    ViewData["Title"] = "Trang nhân viên phục vụ";
    var hoTen = Context.Session.GetString("HoTen") ?? "Nhân viên";
    var total = Model.Count();
    var empty = Model.Count(x => x.TrangThai == "Trong");
    var booked = Model.Count(x => x.TrangThai == "DaDatTruoc");
    var serving = Model.Count(x => x.TrangThai == "DangPhucVu");
}

<div class="page-header">
    <div class="page-header__content">
        <span class="page-kicker"><i class="fa-solid fa-bell-concierge"></i> Phục vụ</span>
        <h1 class="page-title">Xin chào, @hoTen!</h1>
        <p class="page-subtitle">Sơ đồ bàn/chòi giúp nhân viên thao tác nhanh khi khách vào, gọi món hoặc cần xem đơn.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="DonGoiMon" asp-action="Index" class="btn btn-primary-custom">
            <i class="fa-solid fa-clipboard-list me-2"></i>Quản lý đơn gọi món
        </a>
    </div>
</div>

<section class="stats-grid">
    <div class="stat-card stat-card--gold">
        <span class="stat-card__icon"><i class="fa-solid fa-chair"></i></span>
        <span><span class="stat-card__value">@total</span><span class="stat-card__label">Tổng bàn/chòi</span></span>
    </div>
    <div class="stat-card stat-card--green">
        <span class="stat-card__icon"><i class="fa-solid fa-circle-check"></i></span>
        <span><span class="stat-card__value">@empty</span><span class="stat-card__label">Trống</span></span>
    </div>
    <div class="stat-card stat-card--orange">
        <span class="stat-card__icon"><i class="fa-regular fa-calendar-check"></i></span>
        <span><span class="stat-card__value">@booked</span><span class="stat-card__label">Đã đặt trước</span></span>
    </div>
    <div class="stat-card stat-card--red">
        <span class="stat-card__icon"><i class="fa-solid fa-fire-burner"></i></span>
        <span><span class="stat-card__value">@serving</span><span class="stat-card__label">Đang phục vụ</span></span>
    </div>
</section>

<div class="toolbar">
    <div class="input-icon flex-grow-1">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="search" class="form-control" placeholder="Tìm theo bàn/chòi, khu vực hoặc mã đơn" data-filter-target=".js-service-card" />
    </div>
    <select class="form-select" style="max-width: 240px" data-status-filter=".js-service-card">
        <option value="">Tất cả trạng thái</option>
        <option value="Trong">Trống</option>
        <option value="DaDatTruoc">Đã đặt trước</option>
        <option value="DangPhucVu">Đang phục vụ</option>
        <option value="NgungSuDung">Ngừng sử dụng</option>
    </select>
</div>

<div class="table-grid">
    @foreach (var item in Model)
    {
        string statusClass = item.TrangThai switch
        {
            "Trong" => "empty",
            "DaDatTruoc" => "booked",
            "DangPhucVu" => "serving",
            "NgungSuDung" => "stopped",
            _ => "stopped"
        };

        string tenTrangThai = item.TrangThai switch
        {
            "Trong" => "Trống",
            "DaDatTruoc" => "Đã đặt trước",
            "DangPhucVu" => "Đang phục vụ",
            "NgungSuDung" => "Ngừng sử dụng",
            _ => item.TrangThai
        };

        string icon = item.TenBan.Contains("Chòi", StringComparison.OrdinalIgnoreCase) ? "fa-campground" : "fa-chair";

        <article class="restaurant-table-card restaurant-table-card--@statusClass js-service-card"
                 data-status="@item.TrangThai"
                 data-search="@($"{item.MaBan} {item.TenBan} {item.KhuVuc} {item.MaDonGoiMon} {tenTrangThai}")">
            <div class="restaurant-table-card__top">
                <span class="restaurant-table-card__icon"><i class="fa-solid @icon"></i></span>
                <span class="status-badge status-badge--@statusClass">@tenTrangThai</span>
            </div>

            <h2 class="restaurant-table-card__title">@item.TenBan</h2>
            <div class="restaurant-table-card__meta">
                <span><i class="fa-solid fa-location-dot me-2"></i>@item.KhuVuc</span>
                <span><i class="fa-solid fa-users me-2"></i>Sức chứa: @item.SucChua khách</span>
                <span>
                    <i class="fa-solid fa-receipt me-2"></i>
                    @(string.IsNullOrEmpty(item.MaDonGoiMon) ? "Chưa có đơn" : item.MaDonGoiMon)
                </span>
            </div>

            <div class="restaurant-table-card__actions">
                @if (!string.IsNullOrEmpty(item.MaDonGoiMon))
                {
                    <a asp-controller="DonGoiMon" asp-action="Details" asp-route-id="@item.MaDonGoiMon" class="btn btn-primary-custom w-100">
                        <i class="fa-solid fa-eye me-2"></i>Xem đơn
                    </a>
                }
                else if (item.TrangThai == "Trong" || item.TrangThai == "DaDatTruoc")
                {
                    <a asp-controller="DonGoiMon" asp-action="Create" class="btn btn-accent w-100">
                        <i class="fa-solid fa-plus me-2"></i>Lập đơn
                    </a>
                }
                else
                {
                    <span class="text-muted small">Không thao tác</span>
                }
            </div>
        </article>
    }
</div>
