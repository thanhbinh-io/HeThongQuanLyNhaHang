@model IEnumerable<NhaHangThanhThao.ViewModels.DonDatBanIndexViewModel>

@{
    ViewData["Title"] = "Quản lý đơn đặt bàn";
    DateTime? selectedDate = ViewBag.NgayDat is DateTime ngayDat ? ngayDat : null;
    var tomorrow = DateTime.Today.AddDays(1);
    var total = Model.Count();
    var today = Model.Count(x => x.ThoiGianDen.Date == DateTime.Today);
    var tomorrowCount = Model.Count(x => x.ThoiGianDen.Date == tomorrow);
    var deposits = Model.Sum(x => x.TienCoc);
}

<div class="page-header">
    <div class="page-header__content">
        <span class="page-kicker"><i class="fa-regular fa-calendar-check"></i> Lịch đặt bàn</span>
        <h1 class="page-title">Quản lý đơn đặt bàn</h1>
        <p class="page-subtitle">Theo dõi khách đặt trước, lọc theo ngày đến và kiểm tra nhanh lịch đặt của từng bàn/chòi.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary-custom">
            <i class="fa-solid fa-plus me-2"></i>Lập đơn đặt bàn
        </a>
    </div>
</div>

@if (TempData["Error"] != null || TempData["Success"] != null)
{
    <div class="toast-stack">
        @if (TempData["Success"] != null)
        {
            <div class="toast-notice toast-notice--success">
                <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast-notice toast-notice--danger">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            </div>
        }
    </div>
}

<section class="stats-grid">
    <div class="stat-card stat-card--gold">
        <span class="stat-card__icon"><i class="fa-regular fa-calendar-check"></i></span>
        <span><span class="stat-card__value">@total</span><span class="stat-card__label">Tổng đơn đang xem</span></span>
    </div>
    <div class="stat-card stat-card--orange">
        <span class="stat-card__icon"><i class="fa-solid fa-calendar-day"></i></span>
        <span><span class="stat-card__value">@today</span><span class="stat-card__label">Đơn đến hôm nay</span></span>
    </div>
    <div class="stat-card stat-card--green">
        <span class="stat-card__icon"><i class="fa-solid fa-calendar-plus"></i></span>
        <span><span class="stat-card__value">@tomorrowCount</span><span class="stat-card__label">Đơn ngày mai</span></span>
    </div>
    <div class="stat-card">
        <span class="stat-card__icon"><i class="fa-solid fa-coins"></i></span>
        <span><span class="stat-card__value">@deposits.ToString("N0")</span><span class="stat-card__label">Tiền cọc</span></span>
    </div>
</section>

<form asp-action="Index" method="get" class="toolbar">
    <div>
        <label class="form-label">Ngày khách đến</label>
        <input name="ngayDat" type="date" class="form-control"
               value="@(selectedDate.HasValue ? selectedDate.Value.ToString("yyyy-MM-dd") : "")" />
    </div>
    <div class="align-self-end d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary-custom">
            <i class="fa-solid fa-filter me-2"></i>Lọc
        </button>
        <a asp-action="Index" asp-route-ngayDat="@tomorrow.ToString("yyyy-MM-dd")" class="btn btn-accent">
            <i class="fa-regular fa-calendar-plus me-2"></i>Ngày mai
        </a>
        <a asp-action="Index" class="btn btn-outline-primary">
            <i class="fa-solid fa-list me-2"></i>Tất cả
        </a>
    </div>
    <div class="input-icon flex-grow-1 align-self-end">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="search" class="form-control" placeholder="Tìm theo mã đơn, khách hàng, số điện thoại hoặc bàn" data-filter-target=".js-booking-row" />
    </div>
</form>

@if (selectedDate.HasValue)
{
    <div class="alert alert-info border-0 shadow-sm">
        <i class="fa-regular fa-calendar me-2"></i>
        Đang xem các đơn có thời gian đến ngày <strong>@selectedDate.Value.ToString("dd/MM/yyyy")</strong>.
    </div>
}

<div class="table-card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div>
                <i class="fa-regular fa-calendar-check"></i>
                <h2 class="empty-state__title">Chưa có dữ liệu</h2>
                <p>Không có đơn đặt bàn nào trong khoảng đang xem.</p>
                <a asp-action="Create" class="btn btn-primary-custom">Lập đơn đặt bàn</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Thời gian đến</th>
                        <th>Số khách</th>
                        <th>Bàn/chòi</th>
                        <th>Tiền cọc</th>
                        <th>Ghi chú</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="js-booking-row" data-search="@($"{item.MaDonDatBan} {item.TenKhachHang} {item.SoDienThoai} {item.TenBan} {item.GhiChu}")">
                            <td><strong>@item.MaDonDatBan</strong></td>
                            <td>
                                <div><strong>@item.TenKhachHang</strong></div>
                                <div class="text-muted small"><i class="fa-solid fa-phone me-1"></i>@item.SoDienThoai</div>
                            </td>
                            <td>@item.ThoiGianDen.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="status-badge status-badge--active">@item.SoLuongKhach khách</span></td>
                            <td>@item.TenBan</td>
                            <td class="price-text">@item.TienCoc.ToString("N0") VNĐ</td>
                            <td>@item.GhiChu</td>
                            <td class="text-end">
                                <a asp-action="PhieuDatBan" asp-route-id="@item.MaDonDatBan" class="btn btn-info btn-icon btn-sm" data-bs-toggle="tooltip" data-bs-title="In phiếu đặt bàn">
                                    <i class="fa-solid fa-print"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-danger-soft btn-icon btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteBookingModal-@item.MaDonDatBan"
                                        data-bs-title="Xóa đơn đặt bàn">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                                <form asp-action="ChuyenSangDaDat" method="post" class="d-inline">
                                    <input type="hidden" name="maDonDatBan" value="@item.MaDonDatBan" />
                                    <input type="hidden" name="maBan" value="@item.MaBan" />
                                    <button type="submit" class="btn btn-warning btn-sm">
                                        <i class="fa-solid fa-check me-1"></i>Giữ bàn
                                    </button>
                                </form>

                                <div class="modal fade" id="deleteBookingModal-@item.MaDonDatBan" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h2 class="modal-title fs-5">Xóa đơn đặt bàn</h2>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                                            </div>
                                            <div class="modal-body text-start">
                                                <div class="d-flex gap-3">
                                                    <span class="stat-card__icon" style="flex: 0 0 54px;">
                                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                                    </span>
                                                    <div>
                                                        <p class="mb-1">Bạn muốn xóa đơn <strong>@item.MaDonDatBan</strong> của khách <strong>@item.TenKhachHang</strong>?</p>
                                                        <p class="text-muted small mb-0">Chỉ xóa được đơn chưa phát sinh đơn gọi món.</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <form asp-action="Xoa" asp-route-id="@item.MaDonDatBan" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-danger">
                                                        <i class="fa-solid fa-trash me-2"></i>Xóa đơn
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
