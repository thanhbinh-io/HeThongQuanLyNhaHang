@model NhaHangThanhThao.ViewModels.PhieuDatBanViewModel

@{
    ViewData["Title"] = "Phiếu đặt bàn";
}

<div class="page-header no-print">
    <div class="page-header__content">
        <span class="page-kicker"><i class="fa-regular fa-calendar-check"></i> Đặt bàn</span>
        <h1 class="page-title">Phiếu đặt bàn</h1>
        <p class="page-subtitle">Bản in xác nhận thông tin đặt bàn/chòi cho khách hàng.</p>
    </div>
    <div class="page-actions">
        <button type="button" onclick="window.print()" class="btn btn-primary-custom">
            <i class="fa-solid fa-print me-2"></i>In phiếu
        </button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>

<article class="invoice-paper print-surface">
    <header class="invoice-paper__brand">
        <i class="fa-solid fa-utensils"></i>
        <div class="invoice-paper__title">Nhà Hàng Thanh Thảo</div>
        <div class="text-muted">Phiếu xác nhận đặt bàn</div>
    </header>

    <div class="invoice-paper__rule"></div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div><strong>Mã đơn đặt bàn:</strong> @Model.MaDonDatBan</div>
            <div><strong>Khách hàng:</strong> @Model.TenKhachHang</div>
            <div><strong>Số điện thoại:</strong> @Model.SoDienThoai</div>
        </div>
        <div class="col-md-6 text-md-end">
            <div><strong>Ngày lập:</strong> @Model.NgayLap.ToString("dd/MM/yyyy HH:mm")</div>
            <div><strong>Thời gian đến:</strong> @Model.ThoiGianDen.ToString("dd/MM/yyyy HH:mm")</div>
            <div><strong>Số khách:</strong> @Model.SoLuongKhach</div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Bàn/chòi</th>
                    <th>Khu vực</th>
                    <th>Tiền cọc</th>
                    <th>Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>@Model.TenBan</strong> <span class="text-muted">(@Model.MaBan)</span></td>
                    <td>@Model.KhuVuc</td>
                    <td class="price-text">@Model.TienCoc.ToString("N0") VNĐ</td>
                    <td>@(string.IsNullOrWhiteSpace(Model.GhiChu) ? "-" : Model.GhiChu)</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="invoice-paper__rule"></div>

    <div class="row text-center mt-4">
        <div class="col-6">
            <strong>Khách hàng</strong>
            <div class="text-muted mt-5">Ký, ghi rõ họ tên</div>
        </div>
        <div class="col-6">
            <strong>Nhân viên lập phiếu</strong>
            <div class="text-muted mt-5">Ký, ghi rõ họ tên</div>
        </div>
    </div>

    <p class="text-center text-muted mt-4 mb-0">Vui lòng có mặt đúng giờ để nhà hàng phục vụ chu đáo.</p>
</article>
