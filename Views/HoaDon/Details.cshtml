@model NhaHangThanhThao.ViewModels.HoaDonDetailsViewModel

@{
    ViewData["Title"] = "Hóa đơn thanh toán";
}

<div class="page-header no-print">
    <div class="page-header__content">
        <span class="page-kicker"><i class="fa-solid fa-receipt"></i> Hóa đơn</span>
        <h1 class="page-title">Hóa đơn thanh toán</h1>
        <p class="page-subtitle">Bản in hóa đơn cho khách hàng sau khi thanh toán.</p>
    </div>
    <div class="page-actions">
        <button type="button" onclick="window.print()" class="btn btn-primary-custom">
            <i class="fa-solid fa-print me-2"></i>In hóa đơn
        </button>
        <a asp-controller="DonGoiMon" asp-action="Index" class="btn btn-secondary">Quay lại đơn gọi món</a>
    </div>
</div>

<article class="invoice-paper print-surface">
    <header class="invoice-paper__brand">
        <i class="fa-solid fa-utensils"></i>
        <div class="invoice-paper__title">Nhà Hàng Thanh Thảo</div>
        <div class="text-muted">Hóa đơn thanh toán</div>
    </header>

    <div class="invoice-paper__rule"></div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div><strong>Mã hóa đơn:</strong> @Model.MaHoaDon</div>
            <div><strong>Mã đơn gọi món:</strong> @Model.MaDonGoiMon</div>
            <div><strong>Bàn/chòi:</strong> @Model.TenBan</div>
        </div>
        <div class="col-md-6 text-md-end">
            <div><strong>Giờ vào:</strong> @Model.GioVao.ToString("dd/MM/yyyy HH:mm")</div>
            <div><strong>Giờ ra:</strong> @Model.GioRa.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tên món ăn / Dịch vụ</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.ChiTietMons.Count; i++)
                {
                    var item = Model.ChiTietMons[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@item.TenMon</td>
                        <td>@item.SoLuong</td>
                        <td>@item.DonGia.ToString("N0") VNĐ</td>
                        <td>@item.ThanhTien.ToString("N0") VNĐ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="invoice-paper__rule"></div>

    <div class="invoice-totals">
        <div class="invoice-totals__row"><span>Cộng tiền hàng</span><strong>@Model.TongTienMon.ToString("N0") VNĐ</strong></div>
        <div class="invoice-totals__row"><span>Phụ thu / Dịch vụ</span><strong>@Model.PhuThu.ToString("N0") VNĐ</strong></div>
        <div class="invoice-totals__row"><span>Đã đặt cọc</span><strong>- @Model.TienCocKhauTru.ToString("N0") VNĐ</strong></div>
        <div class="invoice-totals__row invoice-totals__row--grand"><span>Tổng cộng</span><strong>@Model.TongThanhToan.ToString("N0") VNĐ</strong></div>
    </div>

    <div class="invoice-paper__rule"></div>

    <div class="row text-center mt-4">
        <div class="col-6">
            <strong>Khách hàng</strong>
            <div class="text-muted mt-5">Ký, ghi rõ họ tên</div>
        </div>
        <div class="col-6">
            <strong>Nhân viên</strong>
            <div class="text-muted mt-5">Ký, ghi rõ họ tên</div>
        </div>
    </div>

    <p class="text-center text-muted mt-4 mb-0">Cảm ơn quý khách và hẹn gặp lại.</p>
</article>
